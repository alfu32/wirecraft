    {
      "id": "node_07b1aef5-8a59-4274-a70b-90995d6ea9b3",
      "name": "socket_respond",
      "kind": "Processor",
      "parentId": "root",
      "children": [],
      "incomingLinks": [
        "32e5289b-5f71-4d77-a5a5-e0a8b107bc63",
        "6ba831b4-0e75-4dbc-bcc0-bad8f3e2db23"
      ],
      "outgoingLinks": [
        "link_47dfe6fa-791b-4863-99ff-002db0ff8f88"
      ],
      "layout": {
        "x": -481.92205758974734,
        "y": 890.6240943417532,
        "width": 200.0,
        "height": 138.0,
        "closedWidth": 200.0,
        "closedHeight": 138.0,
        "openWidth": 200.0,
        "openHeight": 138.0,
        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "ReqRep item;\n\nwhile (threadwork_buffer_count(response) > 0U) {\n    if (pop(response, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n    item.response.header = libhttp->http_render_header(&item.response);\n    if (item.response.header == NULL) {\n        return THREADWORK_ERROR;\n    }\n    if (push(rendered, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Renders the response header of every completed ReqRep arriving on the `response` port\n(libhttp.http_render_header: status line, Content-Type, Content-Length, Connection: close,\nServer; Allow for 405) and forwards it on `rendered` to socket_accept. Any number of\nconsumer links may feed the `response` port; they share one input buffer.",
        "specificationLanguageId": "markdown",
        "tests": "- A 200 text body of 32 bytes yields \"Content-Length: 32\" and ends the header with an empty line.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
