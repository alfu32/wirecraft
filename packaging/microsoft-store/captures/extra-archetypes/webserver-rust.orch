      "text": {
        "source": "",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Self-feedback of pending ReqRep copies that own the request strings until resolution; both of its buffers are the store of in-flight requests that socket_accept searches by id.",
        "specificationLanguageId": "markdown",
        "tests": "",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
      "technology": {
