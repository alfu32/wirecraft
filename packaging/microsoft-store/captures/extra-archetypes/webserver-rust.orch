      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "const TEXT: &str = \"Wirecraft WebServer example: a Rust dataflow HTTP server generated from a Wirecraft model.\\n\";\n\nwhile !routeHomeAboutRequest.is_empty() {\n    let mut item = pop::<ReqRep>(routeHomeAboutRequest)\n        .ok_or(\"routeHomeAbout: request buffer holds a value that is not a ReqRep\")?;\n    item.response.status = 200;\n    item.response.content_type = \"text/plain; charset=utf-8\".into();\n    item.response.body = TEXT.into();\n    push(routeHomeAboutResponse, item);\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "GET/HEAD /home/about. Responds 200 text/plain; charset=utf-8 with a heap-allocated one-line\ndescription of the example. Leaves response.header to socket_respond.",
        "specificationLanguageId": "markdown",
        "tests": "- Body: \"Wirecraft WebServer example: a C17 dataflow HTTP server generated from a Wirecraft model.\"",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
