    {
      "id": "a1832228-ea25-4e9b-9ece-07f7dd635b19",
      "name": "routeNotFound",
      "kind": "Processor",
      "parentId": "node_f0b2f552-0e45-4843-b328-9666bb3357db",
      "children": [],
      "incomingLinks": [
        "cfd0b99d-078f-42a7-8a14-c4a6fe1ad098"
      ],
      "outgoingLinks": [
        "252792fd-dd23-4ac7-96f4-b77ffb328e71"
      ],
      "layout": {
        "x": 588.595023104322,
        "y": 942.95587369488,
        "width": 200.0,
        "height": 70.0,
        "closedWidth": 200.0,
        "closedHeight": 70.0,
        "openWidth": 200.0,
        "openHeight": 70.0,
        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "const KNOWN: [&str; 3] = [\"/home/about\", \"/home/version\", \"/api/user\"];\n\nwhile !routeNotFoundRequest.is_empty() {\n    let mut item = pop::<ReqRep>(routeNotFoundRequest)\n        .ok_or(\"routeNotFound: request buffer holds a value that is not a ReqRep\")?;\n    let mut reason = \"Bad Request\";\n    let mut path = String::new();\n    item.response.status = 400;\n    let fields: Vec<&str> = item.request.header.split_whitespace().take(2).collect();\n    if fields.len() == 2 {\n        path = fields[1].chars().take(255).collect();\n        if let Some(query) = path.find('?') {\n            path.truncate(query);\n        }\n        path = path.chars().take(200).collect();\n        item.response.status = 404;\n        reason = \"Not Found\";\n        if KNOWN.contains(&path.as_str()) {\n            item.response.status = 405;\n            reason = \"Method Not Allowed\";\n        }\n    }\n    item.response.content_type = \"text/plain; charset=utf-8\".into();\n    item.response.body = if item.response.status == 400 {\n        format!(\"400 {reason}\\n\")\n    } else {\n        format!(\"{} {reason}: {path}\\n\", item.response.status)\n    };\n    push(routeNotFoundResponse, item);\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Fallback for everything the router does not match.\n- Unparsable request line: 400 \"400 Bad Request\".\n- Known path with a method other than GET/HEAD: 405 \"405 Method Not Allowed: <path>\"\n  (socket_respond adds \"Allow: GET, HEAD\").\n- Otherwise: 404 \"404 Not Found: <path>\".\nBodies are text/plain; charset=utf-8, heap-allocated, newline-terminated; the path is quoted\nwithout its query string and truncated to 200 bytes.",
        "specificationLanguageId": "markdown",
        "tests": "- \"GET /missing?q=1\" \u2192 404 body \"404 Not Found: /missing\".\n- \"DELETE /api/user\" \u2192 405.\n- \"garbage\" \u2192 400.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
      "technology": {
        "languageId": "",
        "technologyId": "",
        "compilerId": "",
        "fileExtension": "",
        "contentType": ""
      },
