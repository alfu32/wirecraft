        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "// Platform modules for the server libraries: TCP sockets, threads, timeouts and shared state.\nuse std::collections::BTreeMap;\nuse std::io::{ErrorKind, Read, Write};\nuse std::net::{Shutdown, SocketAddr, TcpListener, TcpStream};\nuse std::sync::atomic::{AtomicBool, Ordering};\nuse std::sync::mpsc::{Receiver, channel};\nuse std::sync::{Mutex, MutexGuard};\nuse std::time::Duration;",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Platform library: the POSIX socket, polling and errno headers shared by the server code,\nlent to socket_accept as `platform` and to lib_http_server. It declares no functions.",
        "specificationLanguageId": "markdown",
        "tests": "",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
