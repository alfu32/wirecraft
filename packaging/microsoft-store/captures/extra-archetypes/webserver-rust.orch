      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "const TEXT: &str = \"WebServer 0.1.0 (Wirecraft Rust)\\n\";\n\nwhile !routeHomeVersionRequest.is_empty() {\n    let mut item = pop::<ReqRep>(routeHomeVersionRequest)\n        .ok_or(\"routeHomeVersion: request buffer holds a value that is not a ReqRep\")?;\n    item.response.status = 200;\n    item.response.content_type = \"text/plain; charset=utf-8\".into();\n    item.response.body = TEXT.into();\n    push(routeHomeVersionResponse, item);\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "GET/HEAD /home/version. Responds 200 text/plain; charset=utf-8 with a heap-allocated body\n\"WebServer 0.1.0 (Wirecraft C17)\" and a trailing newline.",
        "specificationLanguageId": "markdown",
        "tests": "- Body equals \"WebServer 0.1.0 (Wirecraft C17)\\n\".",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
