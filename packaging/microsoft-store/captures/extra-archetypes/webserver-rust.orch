        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "const TEXT: &str = concat!(\n    r#\"{\"id\":1,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.invalid\",\"roles\":[\"admin\",\"author\"]}\"#,\n    \"\\n\"\n);\n\nwhile !routeApiUserDetailsRequest.is_empty() {\n    let mut item = pop::<ReqRep>(routeApiUserDetailsRequest)\n        .ok_or(\"routeApiUserDetails: request buffer holds a value that is not a ReqRep\")?;\n    item.response.status = 200;\n    item.response.content_type = \"application/json\".into();\n    item.response.body = TEXT.into();\n    push(routeApiUserDetailsResponse, item);\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "GET/HEAD /api/user. Responds 200 application/json with a placeholder user document:\n{\"id\":1,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.invalid\",\"roles\":[\"admin\",\"author\"]}\nfollowed by a newline. The data is static; no persistence is involved.",
        "specificationLanguageId": "markdown",
        "tests": "- Body parses as JSON and has name \"Ada Lovelace\" and two roles.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
