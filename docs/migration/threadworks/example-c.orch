        {
            "id": "node_968f03ce-27b7-4776-a435-ae0d3a01085a",
            "name": "run.sh",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [],
            "layout": {
                "x": 519.0,
                "y": 726.0,
                "width": 280.0,
                "height": 70.0,
                "closedWidth": 280.0,
