        {
            "id": "node_c43e7a55-0e44-428b-972a-6dab999df396",
            "name": "read_time",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_ecc22fe5-032c-4b24-812b-cc93b4ca76b0"
            ],
            "outgoingLinks": [
                "link_d1b9d286-d43a-439a-bee0-e66bf2943400"
            ],
            "layout": {
                "x": 92.0,
                "y": 1057.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "single-file",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "time_t now = time(NULL);\nstruct tm time_info;\nchar timestamp[32];\n\n// should raise a compilation error // some_nonexisten_function==!!\n\n\nPacket packet = {\n    .timestamp = timestamp,\n    .uuid = NULL,\n    .random_word = NULL,\n    .random_word_length = 0\n};\n\nif (now != (time_t)-1 &&\n    localtime_r(&now, &time_info) != NULL &&\n    tm__strftime(\n        timestamp,\n        sizeof(timestamp),\n        \"%Y-%m-%dT%H:%M:%S%z\",\n        &time_info\n    ) > 0) {\n    packet.isok = true;\n} else {\n    timestamp[0] = '\\0';\n}\n\n\n\npacket.timestamp = strdup(timestamp);\n\nprintf(\"read_time.timestamp:%s\\n\",packet.timestamp != NULL ? packet.timestamp : \"null\");\n\npush(ip_time, &packet);\n",
                "sourceLanguageId": "c",
                "specification": "reads system time and puts it in a Packet and then pushes it into the ip_time output",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
