        {
            "id": "node_98b1de57-6b1a-4a96-8e55-6e9a11eb1fc4",
            "name": "proc_self_argv_lib",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_6d0edf8c-7c32-452a-ab0d-dd384f8cfffc"
            ],
            "outgoingLinks": [
                "link_1a6bae84-65aa-43b8-b8f7-3fe067f296f8"
            ],
            "layout": {
                "x": 874.3333333333335,
                "y": 900.0,
                "width": 214.0,
                "height": 70.0,
                "closedWidth": 214.0,
                "closedHeight": 70.0,
                "openWidth": 214.0,
                "openHeight": 70.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "single-file",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#define ARGPARSE_NOTERM  -1\n#define ARGPARSE_NOVALUE -2\n#define ARGPARSE_OOBOUND -3\n\nstatic char  *argparse_buffer = NULL;\nstatic char **argparse_argv   = NULL;\nstatic int    argparse_argc   = 0;\nstatic int    argparse_loaded = 0;\n\n\n/* --------------------------------------------------------- */\n/* internal loading                                           */\n/* --------------------------------------------------------- */\n\nstatic int argparse_load(void)\n{\n    \n    if (argparse_loaded)\n        return 0;\n\n    FILE *f = fopen(\"/proc/self/cmdline\", \"rb\");\n    if (f == NULL)\n        return ARGPARSE_NOTERM;\n\n    size_t capacity = 256;\n    size_t size = 0;\n\n    argparse_buffer = malloc(capacity);\n    if (argparse_buffer == NULL) {\n        fclose(f);\n        return ARGPARSE_OOBOUND;\n    }\n\n    for (;;) {\n        if (size == capacity) {\n            capacity *= 2;\n\n            char *new_buffer = realloc(argparse_buffer, capacity);\n            if (new_buffer == NULL) {\n                free(argparse_buffer);\n                argparse_buffer = NULL;\n                fclose(f);\n                return ARGPARSE_OOBOUND;\n            }\n\n            argparse_buffer = new_buffer;\n        }\n\n        size_t n = fread(\n            argparse_buffer + size,\n            1,\n            capacity - size,\n            f\n        );\n\n        size += n;\n\n        if (n == 0)\n            break;\n    }\n\n    fclose(f);\n\n    if (size == 0)\n        return ARGPARSE_NOTERM;\n\n    /*\n     * /proc/self/cmdline normally ends in \\0,\n     * but guarantee it ourselves.\n     */\n    if (argparse_buffer[size - 1] != '\\0') {\n        if (size == capacity) {\n            capacity++;\n\n            char *new_buffer = realloc(argparse_buffer, capacity);\n            if (new_buffer == NULL)\n                return ARGPARSE_OOBOUND;\n\n            argparse_buffer = new_buffer;\n        }\n\n        argparse_buffer[size++] = '\\0';\n    }\n\n    /* count arguments */\n    for (size_t i = 0; i < size; i++) {\n        if (argparse_buffer[i] == '\\0')\n            argparse_argc++;\n    }\n\n    argparse_argv = malloc(\n        sizeof(char *) * (size_t)argparse_argc\n    );\n\n    if (argparse_argv == NULL)\n        return ARGPARSE_OOBOUND;\n\n    int index = 0;\n    char *p = argparse_buffer;\n    char *end = argparse_buffer + size;\n\n    while (p < end && index < argparse_argc) {\n        argparse_argv[index++] = p;\n        p += strlen(p) + 1;\n    }\n\n    argparse_loaded = 1;\n    return 0;\n}\n\n\n/* --------------------------------------------------------- */\n/* helpers                                                    */\n/* --------------------------------------------------------- */\n\nstatic int option_like(const char *s)\n{\n    return s != NULL &&\n           s[0] == '-' &&\n           s[1] != '\\0';\n}\n\n\n/* --------------------------------------------------------- */\n/* --name value                                               */\n/* --------------------------------------------------------- */\n\nint option(const char *name, char **option_value)\n{\n    if (argparse_load() < 0)\n        return ARGPARSE_NOTERM;\n\n    if (name == NULL || option_value == NULL)\n        return ARGPARSE_NOTERM;\n\n    *option_value = NULL;\n\n    for (int i = 1; i < argparse_argc; i++) {\n\n        const char *arg = argparse_argv[i];\n\n        if (strncmp(arg, \"--\", 2) != 0)\n            continue;\n\n        const char *actual_name = arg + 2;\n\n        if (strcmp(actual_name, name) == 0) {\n\n            if (i + 1 >= argparse_argc)\n                return ARGPARSE_NOVALUE;\n\n            if (option_like(argparse_argv[i + 1]))\n                return ARGPARSE_NOVALUE;\n\n            *option_value = argparse_argv[i + 1];\n            return i;\n        }\n    }\n\n    return ARGPARSE_NOTERM;\n}\n\n\n/* --------------------------------------------------------- */\n/* -flag                                                      */\n/* --------------------------------------------------------- */\n\nint flag(const char *name)\n{\n    if (argparse_load() < 0)\n        return ARGPARSE_NOTERM;\n\n    if (name == NULL)\n        return ARGPARSE_NOTERM;\n\n    for (int i = 1; i < argparse_argc; i++) {\n\n        const char *arg = argparse_argv[i];\n\n        if (arg[0] != '-' || arg[1] == '-')\n            continue;\n\n        if (strcmp(arg + 1, name) == 0)\n            return i;\n    }\n\n    return ARGPARSE_NOTERM;\n}\n\n\n/* --------------------------------------------------------- */\n/* -p value                                                   */\n/* --------------------------------------------------------- */\n\nint short_option(const char *name, char **option_value)\n{\n    if (argparse_load() < 0)\n        return ARGPARSE_NOTERM;\n\n    if (name == NULL || option_value == NULL)\n        return ARGPARSE_NOTERM;\n\n    *option_value = NULL;\n\n    for (int i = 1; i < argparse_argc; i++) {\n\n        const char *arg = argparse_argv[i];\n\n        if (arg[0] != '-' || arg[1] == '-')\n            continue;\n\n        if (strcmp(arg + 1, name) == 0) {\n\n            if (i + 1 >= argparse_argc)\n                return ARGPARSE_NOVALUE;\n\n            if (option_like(argparse_argv[i + 1]))\n                return ARGPARSE_NOVALUE;\n\n            *option_value = argparse_argv[i + 1];\n            return i;\n        }\n    }\n\n    return ARGPARSE_NOTERM;\n}\n\n\n/* --------------------------------------------------------- */\n/* literal word                                               */\n/* --------------------------------------------------------- */\n\nint word(const char *name)\n{\n    if (argparse_load() < 0)\n        return ARGPARSE_NOTERM;\n\n    if (name == NULL)\n        return ARGPARSE_NOTERM;\n\n    for (int i = 1; i < argparse_argc; i++) {\n\n        if (strcmp(argparse_argv[i], name) == 0)\n            return i;\n    }\n\n    return ARGPARSE_NOTERM;\n}\n\n\n/* --------------------------------------------------------- */\n/* everything from argv[startpos] onward                      */\n/* --------------------------------------------------------- */\n\nint varargs(int startpos, char **results, int capacity)\n{\n    if (argparse_load() < 0)\n        return ARGPARSE_NOTERM;\n\n    if (startpos < 0 || startpos >= argparse_argc)\n        return ARGPARSE_OOBOUND;\n\n    int count = argparse_argc - startpos;\n\n    /*\n     * +1 because results is NULL terminated.\n     */\n    if (results == NULL || capacity < count + 1)\n        return ARGPARSE_OOBOUND;\n\n    for (int i = 0; i < count; i++)\n        results[i] = argparse_argv[startpos + i];\n\n    results[count] = NULL;\n\n    return startpos;\n}\n\n\n/* --------------------------------------------------------- */\n/* raw argv access                                            */\n/* --------------------------------------------------------- */\n\nint get_arg(int n, char **name, char **value)\n{\n    if (argparse_load() < 0)\n        return ARGPARSE_NOTERM;\n\n    if (n < 0 || n >= argparse_argc)\n        return ARGPARSE_OOBOUND;\n\n    if (name == NULL || value == NULL)\n        return ARGPARSE_OOBOUND;\n\n    char *arg = argparse_argv[n];\n\n    *value = NULL;\n\n    /*\n     * --option\n     */\n    if (strncmp(arg, \"--\", 2) == 0) {\n\n        *name = arg + 2;\n\n        if (n + 1 >= argparse_argc ||\n            option_like(argparse_argv[n + 1]))\n            return ARGPARSE_NOVALUE;\n\n        *value = argparse_argv[n + 1];\n        return n;\n    }\n\n    /*\n     * -flag / -option\n     */\n    if (arg[0] == '-' && arg[1] != '\\0') {\n\n        *name = arg + 1;\n\n        /*\n         * Could be a flag, therefore absence of a following\n         * value is not considered an error here.\n         */\n        if (n + 1 < argparse_argc &&\n            !option_like(argparse_argv[n + 1])) {\n            *value = argparse_argv[n + 1];\n        }\n\n        return n;\n    }\n\n    /*\n     * ordinary word\n     */\n    *name = arg;\n    return n;\n}",
                "sourceLanguageId": "",
                "specification": "reads the commandline from \"/proc/self/cmdline\"",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
