let threadworkIdleTicks = 0;

/** Lets host IO, timers and signals run between ticks where the host has timers; idle ticks
 * back off to 25 ms and threadworkRunner.wake() ends the wait. Returns null without timers. */
function threadworkYield(moved) {
  if (typeof setTimeout !== "function") return null;
  if (moved) {
    threadworkIdleTicks = 0;
    return new Promise((resolve) => (typeof setImmediate === "function" ? setImmediate(resolve) : setTimeout(resolve, 0)));
  }
  const delay = Math.min(25, 2 ** Math.min(threadworkIdleTicks++, 5));
  return new Promise((resolve) => {
    const timer = setTimeout(() => {
      threadworkRunner.idleWake = null;
      resolve();
    }, delay);
    threadworkRunner.idleWake = () => {
      clearTimeout(timer);
      resolve();
    };
  });
}

async function threadworkRun() {
  const context = createRuntimeContext();
  threadworkRunner.installShutdownHandlers();
  {{ initializerSymbol }}(context);

  while (threadworkRunner.isRunning()) {
    const transit = threadworkRunner.transit;
    {{ runSymbol }}(context);
    const pause = threadworkYield(threadworkRunner.transit !== transit);
    if (pause) await pause;
  }

  threadworkRunner.beginShutdownDrain(10);
  while (threadworkRunner.hasRecentTransit()) {
    const transit = threadworkRunner.transit;
    {{ runSymbol }}(context);
    const pause = threadworkYield(threadworkRunner.transit !== transit);
    if (pause) await pause;
  }
}

threadworkRun().catch((error) => {
  console.error(error && error.stack ? error.stack : String(error));
  if (globalThis.process) globalThis.process.exitCode = 1;
  else if (globalThis.std) globalThis.std.exit(1);
});
{% endif %}
