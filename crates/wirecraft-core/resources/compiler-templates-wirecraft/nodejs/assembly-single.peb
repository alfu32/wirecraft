{% if isCompilationRoot %}
let threadworkIdleTicks = 0;

/** Lets sockets, timers and signals run between ticks. Consecutive idle ticks back off to 25 ms;
 * threadworkRunner.wake() ends the wait as soon as an event handler has work. */
function threadworkYield(moved) {
  if (moved) {
    threadworkIdleTicks = 0;
    return new Promise((resolve) => setImmediate(resolve));
  }
  const delay = Math.min(25, 2 ** Math.min(threadworkIdleTicks++, 5));
  return new Promise((resolve) => {
    const timer = setTimeout(() => {
      threadworkRunner.idleWake = null;
      resolve();
    }, delay);
    threadworkRunner.idleWake = () => {
      clearTimeout(timer);
      resolve();
    };
  });
}

async function threadworkRun() {
  const context = createRuntimeContext();
  threadworkRunner.installShutdownHandlers();
  {{ initializerSymbol }}(context);

  while (threadworkRunner.isRunning()) {
    const transit = threadworkRunner.transit;
    {{ runSymbol }}(context);
    await threadworkYield(threadworkRunner.transit !== transit);
  }

  threadworkRunner.beginShutdownDrain(10);
  while (threadworkRunner.hasRecentTransit()) {
    const transit = threadworkRunner.transit;
    {{ runSymbol }}(context);
    await threadworkYield(threadworkRunner.transit !== transit);
  }
}

module.exports.threadworkRun = threadworkRun;
if (require.main === module) {
  threadworkRun().catch((error) => {
    console.error(error);
    process.exitCode = 1;
  });
}
{% endif %}
