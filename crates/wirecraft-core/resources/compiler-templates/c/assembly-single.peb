{# Assembles exactly one portable C17 translation unit for the compilation root. #}
{% if isCompilationRoot %}/* Generated by Threadwork's C17 compiler. */
#include <stddef.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <unistd.h>

{{ runtimeSupport }}
{% if hoistedDeclarations is not empty %}
/* Modeled wire and domain types. */
{{ hoistedDeclarations }}
{% endif %}{% if forwardDeclarations is not empty %}
/* Generated application prototypes. */
{{ forwardDeclarations }}
{% endif %}{% endif %}{% if inlineChildDeclarations is not empty %}
/* Generated child definitions. */
{{ inlineChildDeclarations }}
{% endif %}
/* Generated root definition. */
{{ ownDeclaration }}
{% if isCompilationRoot %}

int main(void)
{
    threadwork_context context;
    threadwork_error_t status;
    int running;
    int recent_transit;

    status = threadwork_runner__init(&threadwork_runner);
    if (status != THREADWORK_OK) {
        return EXIT_FAILURE;
    }

    if (threadwork_context_init(&context) != THREADWORK_OK) {
        (void)threadwork_runner__destroy(&threadwork_runner);
        return EXIT_FAILURE;
    }

    status = threadwork_runner__install_shutdown_signal_handlers(&threadwork_runner);
    if (status == THREADWORK_OK) {
        status = tw_{{ initializerSymbol }}(&context);
    }
    while (status == THREADWORK_OK) {
        status = threadwork_runner__is_running(&threadwork_runner, &running);
        if (status != THREADWORK_OK || !running) {
            break;
        }
        status = tw_{{ runSymbol }}(&context);
    }

    if (status == THREADWORK_OK) {
        status = threadwork_runner__begin_shutdown_drain(&threadwork_runner, 10U);
        while (status == THREADWORK_OK) {
            status = threadwork_runner__has_recent_transit(&threadwork_runner, &recent_transit);
            if (status != THREADWORK_OK || !recent_transit) {
                break;
            }
            status = tw_{{ runSymbol }}(&context);
        }
    }

    threadwork_context_destroy(&context);
    (void)threadwork_runner__destroy(&threadwork_runner);
    return status == THREADWORK_OK ? EXIT_SUCCESS : EXIT_FAILURE;
}
{% endif %}
