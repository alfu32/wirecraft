{# Shared execution state for one generated PHP application. #}
if (!class_exists('ThreadworkRunner')) {
final class ThreadworkRunner
{
    private bool $running = true;
    private int $shutdownSignal = 0;
    private int $transit = 0;
    private int $shutdownPreviousTransit = 0;
    private int $shutdownIdleTicks = 0;
    private int $shutdownRemainingTicks = 0;

    /** @brief Request shutdown; modeled nodes decide whether they continue emitting packets. */
    public function shutdownRequest(): void
    {
        $this->running = false;
    }

    /** @brief Return the last SIGINT or SIGTERM number received by the runtime, or zero. */
    public function getShutdownSignal(): int
    {
        return $this->shutdownSignal;
    }

    /** @brief Return the requested running state for modeled code to inspect. */
    public function isRunning(): bool
    {
        return $this->running;
    }

    /** @brief Increment the count of packets completed by modeled transports. */
    public function recordTransit(): void
    {
        $this->transit++;
    }

    /** @brief Start the bounded idle window used to drain residual network traffic. */
    public function beginShutdownDrain(int $idleTicks): void
    {
        $this->shutdownPreviousTransit = $this->transit;
        $this->shutdownIdleTicks = $idleTicks;
        $this->shutdownRemainingTicks = $idleTicks;
    }

    /** @brief Return true while transport activity or the idle drain window remains. */
    public function hasRecentTransit(): bool
    {
        printf(
            "[ThreadworkRunner::hasRecentTransit] transit=%d previous=%d remaining=%d\n",
            $this->transit,
            $this->shutdownPreviousTransit,
            $this->shutdownRemainingTicks
        );
        if ($this->transit !== $this->shutdownPreviousTransit) {
            $this->shutdownPreviousTransit = $this->transit;
            $this->shutdownRemainingTicks = $this->shutdownIdleTicks;
            return true;
        }
        if ($this->shutdownRemainingTicks === 0) return false;
        $this->shutdownRemainingTicks--;
        return true;
    }

    /** @brief Install SIGINT and SIGTERM handlers when PCNTL is available. */
    public function installShutdownHandlers(): void
    {
        if (!function_exists('pcntl_signal')) return;
        pcntl_async_signals(true);
        $handleSignal = function (int $signal): void {
            $this->shutdownSignal = $signal;
            $this->shutdownRequest();
        };
        pcntl_signal(SIGINT, $handleSignal);
        pcntl_signal(SIGTERM, $handleSignal);
    }
}
}

$GLOBALS['threadwork_runner'] ??= new ThreadworkRunner();

if (!function_exists('threadwork_runner')) {
/** @brief Return the generated application's Threadwork runner. */
function threadwork_runner(): ThreadworkRunner
{
    return $GLOBALS['threadwork_runner'];
}
}

if (!function_exists('createRuntimeContext')) {
/** @brief Create the shared context passed to generated PHP nodes. */
function createRuntimeContext(): array
{
    return ['imports' => []];
}
}
