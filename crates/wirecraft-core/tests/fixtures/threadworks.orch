        {
            "id": "node_6cecd43e-ac7b-4287-816c-e91b850e9f1f",
            "name": "write_result",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_84ae475d-2acf-4ff4-b95c-0c5ac8492430",
                "link_9ce5604a-b505-42cf-90b9-9fe7dbc7283d"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 870.0,
                "y": 90.0,
                "width": 280.0,
                "height": 78.0,
                "closedWidth": 280.0,
                "closedHeight": 78.0,
                "openWidth": 280.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "static char result_csv[8192] = \"city,user_count\\n\";\nstatic int output_written = 0;\n\nwhile (threadwork_buffer_count(data_in) > 0U) {\n    CityCount record;\n    char line[256];\n    int line_length;\n\n    if (pop(data_in, &record) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n\n    line_length = snprintf(line, sizeof(line), \"\\\"%s\\\",%zu\\n\", record.city, record.user_count);\n    if (line_length < 0 || (size_t)line_length >= sizeof(line)) {\n        return THREADWORK_ERROR;\n    }\n    if (strlen(result_csv) + (size_t)line_length + 1U >= sizeof(result_csv)) {\n        return THREADWORK_ERROR;\n    }\n    strcat(result_csv, line);\n}\n\nif (!output_written) {\n    int shutdown_requested = 0;\n    if (threadwork_runner__get_shutdown_signal(&threadwork_runner, &shutdown_requested) == THREADWORK_OK && shutdown_requested != 0) {\n        if (csv_writer_io__write_file_text(\"result.csv\", result_csv) != 0) {\n            return THREADWORK_ERROR;\n        }\n        output_written = 1;\n    }\n}",
                "sourceLanguageId": "c",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
