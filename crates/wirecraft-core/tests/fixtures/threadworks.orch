            ],
            "layout": {
                "x": 465.0,
                "y": 235.0,
                "width": 280.0,
                "height": 78.0,
                "closedWidth": 280.0,
                "closedHeight": 78.0,
                "openWidth": 280.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "if (threadwork_buffer_count(rows_in) > 0U) {\n    CsvUsers users;\n    CityCount *groups;\n    size_t group_count = 0U;\n\n    if (pop(rows_in, &users) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n\n    groups = csv_table_service__csv_users_group_by_city(&users, &group_count);\n    if (group_count > 0U && groups == NULL) {\n        csv_table_service__csv_table_free(&users);\n        return THREADWORK_ERROR;\n    }\n\n    for (size_t index = 0U; index < group_count; ++index) {\n        if (push(data, &groups[index]) != THREADWORK_OK) {\n            free(groups);\n            csv_table_service__csv_table_free(&users);\n            return THREADWORK_ERROR;\n        }\n    }\n\n    free(groups);\n    csv_table_service__csv_table_free(&users);\n}",
                "sourceLanguageId": "c",
                "specification": "",
                "specificationLanguageId": "markdown",
