                "closedHeight": 82.0,
                "openWidth": 350.0,
                "openHeight": 82.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nchar *read_file_text(const char *path) {\n    FILE *file;\n    long size;\n    char *buffer;\n\n    if (path == NULL) {\n        return NULL;\n    }\n\n    file = fopen(path, \"rb\");\n    if (file == NULL) {\n        return NULL;\n    }\n\n    if (fseek(file, 0, SEEK_END) != 0) {\n        fclose(file);\n        return NULL;\n    }\n\n    size = ftell(file);\n    if (size < 0 || fseek(file, 0, SEEK_SET) != 0) {\n        fclose(file);\n        return NULL;\n    }\n\n    buffer = malloc((size_t)size + 1U);\n    if (buffer == NULL) {\n        fclose(file);\n        return NULL;\n    }\n\n    if (fread(buffer, 1U, (size_t)size, file) != (size_t)size) {\n        free(buffer);\n        fclose(file);\n        return NULL;\n    }\n\n    buffer[size] = '\\0';\n    fclose(file);\n    return buffer;\n}\n\nint write_file_text(const char *path, const char *content) {\n    FILE *file;\n    size_t length;\n\n    if (path == NULL || content == NULL) {\n        return -1;\n    }\n\n    file = fopen(path, \"wb\");\n    if (file == NULL) {\n        return -1;\n    }\n\n    length = strlen(content);\n    if (fwrite(content, 1U, length, file) != length) {\n        fclose(file);\n        return -1;\n    }\n\n    return fclose(file) == 0 ? 0 : -1;\n}",
                "sourceLanguageId": "c",
                "specification": "File service library with complete buffered reads and checked writes.",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
