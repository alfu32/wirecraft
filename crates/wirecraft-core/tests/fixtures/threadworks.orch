            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "static int csv_reader_emitted = 0;\n\nif (csv_reader_emitted == 0) {\n    char *csv_text = csv_reader_io__read_file_text(\"users.csv\");\n    CsvUsers users;\n\n    if (csv_text == NULL) return THREADWORK_ERROR;\n    users = csv_reader_table__csv_table_parse(csv_text);\n    free(csv_text);\n\n    if (users.cells == NULL || users.city_column >= users.column_count) {\n        return THREADWORK_ERROR;\n    }\n    if (push(rows, &users) != THREADWORK_OK) {\n        csv_reader_table__csv_table_free(&users);\n        return THREADWORK_ERROR;\n    }\n    csv_reader_emitted = 1;\n} else {\n    if (threadwork_runner__shutdown_request(&threadwork_runner) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n}",
                "sourceLanguageId": "c",
