        {
            "id": "node_da35cebe-9481-409a-8adb-aa9c1d730605",
            "name": "lib_csv_table",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [
                "link_5552ea52-1237-4873-9fe1-c6d00e1164f5",
                "link_6891a16a-b6ec-42ba-8262-d5f0de2043da"
            ],
            "layout": {
                "x": 810.0,
                "y": 455.0,
                "width": 350.0,
                "height": 82.0,
                "closedWidth": 350.0,
                "closedHeight": 82.0,
                "openWidth": 350.0,
                "openHeight": 82.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "#include <stdlib.h>\n#include <string.h>\n\nvoid csv_table_free(CsvUsers *users);\n\nstatic char *duplicate_field(const char *start, size_t length) {\n    char *value = malloc(length + 1U);\n\n    if (value == NULL) {\n        return NULL;\n    }\n\n    memcpy(value, start, length);\n    value[length] = '\\0';\n    return value;\n}\n\nstatic size_t count_columns(const char *line) {\n    size_t count = 1U;\n\n    for (const char *cursor = line; *cursor != '\\0'; ++cursor) {\n        if (*cursor == ',') {\n            ++count;\n        }\n    }\n\n    return count;\n}\n\nstatic char **split_line(const char *line, size_t column_count) {\n    char **columns = calloc(column_count, sizeof(*columns));\n    const char *field_start = line;\n    size_t column = 0U;\n\n    if (columns == NULL) {\n        return NULL;\n    }\n\n    for (const char *cursor = line;; ++cursor) {\n        if (*cursor != ',' && *cursor != '\\0') {\n            continue;\n        }\n\n        if (column >= column_count) {\n            break;\n        }\n\n        columns[column] = duplicate_field(\n            field_start,\n            (size_t)(cursor - field_start)\n        );\n        if (columns[column] == NULL) {\n            for (size_t index = 0U; index < column; ++index) {\n                free(columns[index]);\n            }\n            free(columns);\n            return NULL;\n        }\n\n        ++column;\n        if (*cursor == '\\0') {\n            break;\n        }\n\n        field_start = cursor + 1;\n    }\n\n    return columns;\n}\n\nCsvUsers csv_table_parse(const char *csv_text) {\n    CsvUsers table = {0};\n    char *copy;\n    char *line;\n    size_t capacity = 8U;\n    size_t city_column = (size_t)-1;\n\n    if (csv_text == NULL) {\n        return table;\n    }\n\n    copy = malloc(strlen(csv_text) + 1U);\n    if (copy == NULL) {\n        return table;\n    }\n    strcpy(copy, csv_text);\n\n    table.cells = calloc(capacity, sizeof(*table.cells));\n    if (table.cells == NULL) {\n        free(copy);\n        return (CsvUsers){0};\n    }\n\n    line = strtok(copy, \"\\n\");\n    if (line == NULL) {\n        free(copy);\n        csv_table_free(&table);\n        return (CsvUsers){0};\n    }\n\n    table.column_count = count_columns(line);\n\n    {\n        char **header = split_line(line, table.column_count);\n\n        if (header == NULL) {\n            free(copy);\n            csv_table_free(&table);\n            return (CsvUsers){0};\n        }\n\n        for (size_t column = 0U; column < table.column_count; ++column) {\n            if (strcmp(header[column], \"city\") == 0) {\n                city_column = column;\n            }\n            free(header[column]);\n        }\n        free(header);\n    }\n\n    if (city_column == (size_t)-1) {\n        free(copy);\n        csv_table_free(&table);\n        return (CsvUsers){0};\n    }\n\n    while ((line = strtok(NULL, \"\\n\")) != NULL) {\n        if (table.row_count == capacity) {\n            capacity *= 2U;\n\n            char ***expanded = realloc(\n                table.cells,\n                capacity * sizeof(*table.cells)\n            );\n            if (expanded == NULL) {\n                free(copy);\n                csv_table_free(&table);\n                return (CsvUsers){0};\n            }\n            table.cells = expanded;\n        }\n\n        table.cells[table.row_count] = split_line(line, table.column_count);\n        if (table.cells[table.row_count] == NULL) {\n            free(copy);\n            csv_table_free(&table);\n            return (CsvUsers){0};\n        }\n\n        ++table.row_count;\n    }\n\n    table.city_column = city_column;\n    free(copy);\n    return table;\n}\n\nCityCount *csv_users_group_by_city(\n    const CsvUsers *users,\n    size_t *group_count\n) {\n    CityCount *groups;\n    size_t count = 0U;\n    size_t capacity = 8U;\n\n    if (group_count == NULL) {\n        return NULL;\n    }\n    *group_count = 0U;\n\n    if (users == NULL || users->cells == NULL) {\n        return NULL;\n    }\n\n    groups = calloc(capacity, sizeof(*groups));\n    if (groups == NULL) {\n        return NULL;\n    }\n\n    for (size_t row = 0U; row < users->row_count; ++row) {\n        const char *city = users->cells[row][users->city_column];\n        size_t group = 0U;\n\n        while (group < count && strcmp(groups[group].city, city) != 0) {\n            ++group;\n        }\n\n        if (group == count) {\n            if (count == capacity) {\n                capacity *= 2U;\n\n                CityCount *expanded = realloc(\n                    groups,\n                    capacity * sizeof(*groups)\n                );\n                if (expanded == NULL) {\n                    free(groups);\n                    return NULL;\n                }\n                groups = expanded;\n            }\n\n            groups[count].city = city;\n            groups[count].user_count = 0U;\n            ++count;\n        }\n\n        ++groups[group].user_count;\n    }\n\n    *group_count = count;\n    return groups;\n}\n\nvoid csv_table_free(CsvUsers *users) {\n    if (users == NULL || users->cells == NULL) {\n        return;\n    }\n\n    for (size_t row = 0U; row < users->row_count; ++row) {\n        for (size_t column = 0U; column < users->column_count; ++column) {\n            free(users->cells[row][column]);\n        }\n        free(users->cells[row]);\n    }\n\n    free(users->cells);\n    users->cells = NULL;\n    users->row_count = 0U;\n    users->column_count = 0U;\n    users->city_column = 0U;\n}",
                "sourceLanguageId": "c",
                "specification": "Complete CSV table service with owned row storage, city-column detection, aggregation, and cleanup.",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
