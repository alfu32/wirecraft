{
  "id": "workflow-template-php-http-writer",
  "name": "http_writer",
  "rootNodeId": "template_root_php_http_writer",
  "nodes": [
    {
      "id": "template_root_php_http_writer",
      "name": "http_writer",
      "kind": "Group",
      "children": [
        "http_writer"
      ],
      "layout": {
        "x": 40,
        "y": 40,
        "width": 500,
        "height": 240
      }
    },
    {
      "id": "http_writer",
      "name": "http_writer",
      "kind": "Processor",
      "parentId": "template_root_php_http_writer",
      "layout": {
        "x": 100,
        "y": 115,
        "width": 260,
        "height": 90
      },
      "technology": {
        "languageId": "php",
        "technologyId": "php",
        "compilerId": "php-compiler"
      },
      "ports": [
        {
          "id": "config",
          "name": "config",
          "direction": "Input",
          "dataType": "HttpWriterConfig"
        },
        {
          "id": "request",
          "name": "request",
          "direction": "Input",
          "dataType": "HttpRequest"
        }
      ],
      "text": {
        "source": "if (!$config || !$request) return;\n$settings = $config[0];\n$packet = array_shift($request);\nif (empty($settings['url'])) throw new InvalidArgumentException('http_writer requires config.url');\n$method = strtoupper($settings['method'] ?? 'POST');\n$headers = $settings['headers'] ?? [];\n$options = ['http' => ['method' => $method, 'header' => implode(\"\\r\\n\", array_map(fn($key, $value) => $key . ': ' . $value, array_keys($headers), $headers)), 'content' => (string)($packet['request_text'] ?? $packet['content'] ?? ''), 'ignore_errors' => true]];\n$content = @file_get_contents($settings['url'], false, stream_context_create($options));\nif ($content === false || str_starts_with($http_response_header[0] ?? '', 'HTTP/1.1 4') || str_starts_with($http_response_header[0] ?? '', 'HTTP/1.1 5')) throw new RuntimeException('HTTP writer request failed');",
        "specification": "Consumes request packets and sends each one to the configured HTTP endpoint.\n\nPort contract: input port/link `config` supplies `HttpWriterConfig`; input port/link `request` supplies packets to send.\n\nConfiguration contains `method`, `url`, and `headers`. `method` and `url` are required; headers are merged predictably with packet-specific content metadata without creating contradictory Content-Length or transfer-encoding values.\n\nFor every packet received on `request`, send one bounded HTTP request. Preserve packet order unless concurrency is explicitly enabled. Treat non-success status codes and transport failures according to the project's error policy; do not silently discard failed packets. Do not block the Threadwork run cycle while waiting on remote I/O.",
        "aiInstructions": "Send exactly one HTTP request per input packet using the configured method, URL, and headers. Make retry and idempotency behavior explicit."
      }
    }
  ]
}
