{
  "id": "workflow-template-c-http-writer",
  "name": "http_writer",
  "rootNodeId": "template_root_c_http_writer",
  "nodes": [
    {
      "id": "template_root_c_http_writer",
      "name": "http_writer",
      "kind": "Group",
      "children": [
        "http_writer"
      ],
      "layout": {
        "x": 40,
        "y": 40,
        "width": 500,
        "height": 240
      }
    },
    {
      "id": "http_writer",
      "name": "http_writer",
      "kind": "Processor",
      "parentId": "template_root_c_http_writer",
      "layout": {
        "x": 100,
        "y": 115,
        "width": 260,
        "height": 90
      },
      "technology": {
        "languageId": "c",
        "technologyId": "c-native",
        "compilerId": "c-compiler"
      },
      "ports": [
        {
          "id": "config",
          "name": "config",
          "direction": "Input",
          "dataType": "HttpWriterConfig"
        },
        {
          "id": "request",
          "name": "request",
          "direction": "Input",
          "dataType": "HttpRequest"
        }
      ],
      "text": {
        "source": "typedef struct { const char *method; const char *url; const char *headers; } HttpWriterConfig;\ntypedef struct { const char *request_text; const char *content; } HttpRequest;\nextern int system(const char *);\nHttpWriterConfig settings;\nHttpRequest packet;\nif (pop(config, &settings) != THREADWORK_QUEUE_OK) return THREADWORK_OK;\nif (pop(request, &packet) != THREADWORK_QUEUE_OK) return THREADWORK_OK;\nif (settings.url == NULL || settings.method == NULL || packet.request_text == NULL) return THREADWORK_ERROR;\n/* Keep the command adapter replaceable; callers should quote values for their deployment. */\nchar command[4096];\nsnprintf(command, sizeof(command), \"curl --silent --show-error --max-time 10 -X '%s' --data-binary '%s' '%s'\", settings.method, packet.request_text, settings.url);\nreturn system(command) == 0 ? THREADWORK_OK : THREADWORK_ERROR;",
        "specification": "Consumes request packets and sends each one to the configured HTTP endpoint.\n\nPort contract: input port/link `config` supplies `HttpWriterConfig`; input port/link `request` supplies packets to send.\n\nConfiguration contains `method`, `url`, and `headers`. `method` and `url` are required; headers are merged predictably with packet-specific content metadata without creating contradictory Content-Length or transfer-encoding values.\n\nFor every packet received on `request`, send one bounded HTTP request. Preserve packet order unless concurrency is explicitly enabled. Treat non-success status codes and transport failures according to the project's error policy; do not silently discard failed packets. Do not block the Threadwork run cycle while waiting on remote I/O.",
        "aiInstructions": "Send exactly one HTTP request per input packet using the configured method, URL, and headers. Make retry and idempotency behavior explicit."
      }
    }
  ]
}
