      "layout": { "x": 90, "y": 115, "width": 250, "height": 70 },
      "technology": { "languageId": "c", "technologyId": "c-native", "compilerId": "c-compiler" },
      "text": {
        "sourceLanguageId": "c",
        "source": "int shutdown_signal = 0;\nif (threadwork_runner__get_shutdown_signal(&threadwork_runner, &shutdown_signal) != THREADWORK_OK) {\n    return THREADWORK_ERROR;\n}\nif (shutdown_signal == SIGTERM) {\n    return threadwork_runner__shutdown_request(&threadwork_runner);\n}",
        "specification": "Probes the SIGTERM recorded by the C runtime and requests an orderly network shutdown. Residual packets continue through the runtime drain phase."
      }
    }
  ]
}
