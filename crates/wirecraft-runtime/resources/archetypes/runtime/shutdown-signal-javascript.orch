      "text": {
        "sourceLanguageId": "javascript",
        "source": "if (threadworkRunner.getShutdownSignal() === 15) {\n  threadworkRunner.shutdownRequest();\n  return;\n}",
        "specification": "Probes the SIGTERM recorded by the Node.js runtime and requests an orderly network shutdown. Residual packets continue through the runtime drain phase."
