      "technology": { "languageId": "php", "technologyId": "php", "compilerId": "php-compiler" },
      "text": {
        "sourceLanguageId": "php",
        "source": "// POSIX SIGTERM is 15; this remains safe without the PCNTL extension.\n$runner = threadwork_runner();\nif ($runner->getShutdownSignal() === 15) {\n    $runner->shutdownRequest();\n    return;\n}",
        "specification": "Probes the SIGTERM recorded by the PHP runtime and requests an orderly network shutdown. Residual packets continue through the runtime drain phase."
      }
    }
  ]
