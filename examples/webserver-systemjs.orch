    {
      "id": "a1832228-ea25-4e9b-9ece-07f7dd635b19",
      "name": "routeNotFound",
      "kind": "Processor",
      "parentId": "node_f0b2f552-0e45-4843-b328-9666bb3357db",
      "children": [],
      "incomingLinks": [
        "cfd0b99d-078f-42a7-8a14-c4a6fe1ad098"
      ],
      "outgoingLinks": [
        "252792fd-dd23-4ac7-96f4-b77ffb328e71"
      ],
      "layout": {
        "x": 588.595023104322,
        "y": 942.95587369488,
        "width": 200.0,
        "height": 70.0,
        "closedWidth": 200.0,
        "closedHeight": 70.0,
        "openWidth": 200.0,
        "openHeight": 70.0,
        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "const known = [\"/home/about\", \"/home/version\", \"/api/user\"];\n\nwhile (routeNotFoundRequest.length > 0) {\n  const item = routeNotFoundRequest.shift();\n  let status = 400;\n  let reason = \"Bad Request\";\n  let path = \"\";\n  const [, target] = item.request.header.trim().split(/\\s+/);\n  if (target !== undefined) {\n    path = target.slice(0, 255).split(\"?\")[0].slice(0, 200);\n    status = 404;\n    reason = \"Not Found\";\n    if (known.includes(path)) {\n      status = 405;\n      reason = \"Method Not Allowed\";\n    }\n  }\n  const body = status === 400 ? `400 ${reason}\\n` : `${status} ${reason}: ${path}\\n`;\n  item.response = { ...item.response, status, content_type: \"text/plain; charset=utf-8\", body };\n  routeNotFoundResponse.push(item);\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Fallback for everything the router does not match.\n- Unparsable request line: 400 \"400 Bad Request\".\n- Known path with a method other than GET/HEAD: 405 \"405 Method Not Allowed: <path>\"\n  (socket_respond adds \"Allow: GET, HEAD\").\n- Otherwise: 404 \"404 Not Found: <path>\".\nBodies are text/plain; charset=utf-8, heap-allocated, newline-terminated; the path is quoted\nwithout its query string and truncated to 200 bytes.",
        "specificationLanguageId": "markdown",
        "tests": "- \"GET /missing?q=1\" → 404 body \"404 Not Found: /missing\".\n- \"DELETE /api/user\" → 405.\n- \"garbage\" → 400.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
      "technology": {
        "languageId": "",
        "technologyId": "",
        "compilerId": "",
        "fileExtension": "",
        "contentType": ""
      },
      "ports": [
        {
          "id": "input_in",
          "name": "in",
          "direction": "Input",
          "dataType": "",
          "metadata": {}
        },
        {
          "id": "output_out",
          "name": "out",
          "direction": "Output",
          "dataType": "",
          "metadata": {}
        }
      ],
      "link": null,
