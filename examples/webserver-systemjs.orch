        "closedWidth": 200.0,
        "closedHeight": 70.0,
        "openWidth": 200.0,
        "openHeight": 70.0,
        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "// Platform modules for the server libraries: TCP sockets from the host. systemJS scripts are\n// engine-neutral; this design needs a host with `node:net`, such as Bun or Node.js.\nconst net = require(\"node:net\");",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Platform library: the POSIX socket, polling and errno headers shared by the server code,\nlent to socket_accept as `platform` and to lib_http_server. It declares no functions.",
        "specificationLanguageId": "markdown",
        "tests": "",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
