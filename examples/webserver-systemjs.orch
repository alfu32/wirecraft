    {
      "id": "node_edd0ae62-3c39-40da-83d6-16d04bcd1cd4",
      "name": "base_lib",
      "kind": "Processor",
      "parentId": "root",
      "children": [],
      "incomingLinks": [],
      "outgoingLinks": [
        "95f28f57-d01a-4781-bc3c-ecca3987459d",
        "link_559f3fef-7b5a-4d0e-9d55-8f70aa5c46b8"
      ],
