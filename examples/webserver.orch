        "technologyId": ""
      },
      "text": {
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown",
        "initialization": "",
        "initializationLanguageId": "",
        "source": "static const char text[] = \"WebServer 0.1.0 (Wirecraft C17)\\n\";\nReqRep item;\n\nwhile (threadwork_buffer_count(routeHomeVersionRequest) > 0U) {\n    if (pop(routeHomeVersionRequest, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n    item.response.status = 200;\n    item.response.content_type = \"text/plain; charset=utf-8\";\n    item.response.body = (char *)malloc(sizeof(text));\n    if (item.response.body == NULL) {\n        return THREADWORK_ERROR;\n    }\n    memcpy(item.response.body, text, sizeof(text));\n    if (push(routeHomeVersionResponse, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n}",
        "sourceLanguageId": "",
        "specification": "GET/HEAD /home/version. Responds 200 text/plain; charset=utf-8 with a heap-allocated body\n\"WebServer 0.1.0 (Wirecraft C17)\" and a trailing newline.",
        "specificationLanguageId": "markdown",
        "tests": "- Body equals \"WebServer 0.1.0 (Wirecraft C17)\\n\".",
        "testsLanguageId": "json"
      },
      "typeDefinition": null
    },
    {
      "assignee": null,
      "binaryContent": null,
      "children": [],
      "diagnostics": [],
      "fileLayoutStrategyId": "none",
      "id": "a1832228-ea25-4e9b-9ece-07f7dd635b19",
      "incomingLinks": [
        "cfd0b99d-078f-42a7-8a14-c4a6fe1ad098"
      ],
      "kind": "Processor",
      "layout": {
        "closedHeight": 70.0,
        "closedWidth": 200.0,
        "height": 70.0,
        "isExpanded": true,
