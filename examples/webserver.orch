        "technologyId": ""
      },
      "text": {
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown",
        "initialization": "",
        "initializationLanguageId": "",
        "source": "static const char text[] = \"{\\\"id\\\":1,\\\"name\\\":\\\"Ada Lovelace\\\",\\\"email\\\":\\\"ada@example.invalid\\\",\\\"roles\\\":[\\\"admin\\\",\\\"author\\\"]}\\n\";\n\n\nReqRep item;\n\nwhile (threadwork_buffer_count(routeApiUserDetailsRequest) > 0U) {\n    if (pop(routeApiUserDetailsRequest, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n    item.response.status = 200;\n    item.response.content_type = \"application/json\";\n    item.response.body = (char *)malloc(sizeof(text));\n    if (item.response.body == NULL) {\n        return THREADWORK_ERROR;\n    }\n    memcpy(item.response.body, text, sizeof(text));\n    if (push(routeApiUserDetailsResponse, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n}",
        "sourceLanguageId": "",
        "specification": "GET/HEAD /api/user. Responds 200 application/json with a placeholder user document:\n{\"id\":1,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.invalid\",\"roles\":[\"admin\",\"author\"]}\nfollowed by a newline. The data is static; no persistence is involved.",
        "specificationLanguageId": "markdown",
        "tests": "- Body parses as JSON and has name \"Ada Lovelace\" and two roles.",
        "testsLanguageId": "json"
      },
      "typeDefinition": null
    },
