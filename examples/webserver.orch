    {
      "id": "node_07b1aef5-8a59-4274-a70b-90995d6ea9b3",
      "name": "socket_respond",
      "kind": "Processor",
      "parentId": "root",
      "children": [],
      "incomingLinks": [
        "252792fd-dd23-4ac7-96f4-b77ffb328e71",
        "32e5289b-5f71-4d77-a5a5-e0a8b107bc63",
        "link_1eb6b930-6980-40be-8710-8ed323817aa7",
        "link_4cc82930-d2e5-431c-a48c-8b676d08ad57",
        "link_d40b1933-7e41-4f24-924d-f7fd683cedfd"
      ],
      "outgoingLinks": [
        "link_47dfe6fa-791b-4863-99ff-002db0ff8f88"
      ],
      "layout": {
        "x": 1424.8145626723751,
        "y": 731.3664223096141,
        "width": 200.0,
        "height": 138.0,
        "closedWidth": 200.0,
        "closedHeight": 138.0,
        "openWidth": 200.0,
        "openHeight": 138.0,
        "isExpanded": true
      },
      "fileLayoutStrategyId": "single-file",
      "text": {
        "source": "threadwork_buffer *answered[4];\nsize_t index;\nReqRep item;\n\nanswered[0] = routeHomeAboutResponse;\nanswered[1] = routeHomeVersionResponse;\nanswered[2] = routeApiUserDetailsResponse;\nanswered[3] = routeNotFoundResponse;\nfor (index = 0U; index < 4U; index++) {\n    while (threadwork_buffer_count(answered[index]) > 0U) {\n        if (pop(answered[index], &item) != THREADWORK_OK) {\n            return THREADWORK_ERROR;\n        }\n        item.response.header = libhttp->http_render_header(&item.response);\n        if (item.response.header == NULL) {\n            return THREADWORK_ERROR;\n        }\n        if (push(response, &item) != THREADWORK_OK) {\n            return THREADWORK_ERROR;\n        }\n    }\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Completes each route response.\nPop every ReqRep from the four route*Response links (about, version, user, not-found order),\nset response.header with libhttp.http_render_header — status line, Content-Type, exact\nContent-Length of response.body, Connection: close, Server and, for 405, Allow — and push it\nto `response` for socket_accept.",
        "specificationLanguageId": "markdown",
        "tests": "- A 200 text body of 32 bytes yields \"Content-Length: 32\" and ends the header with an empty line.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
      "technology": {
        "languageId": "",
        "technologyId": "",
        "compilerId": "",
        "fileExtension": "",
        "contentType": ""
      },
      "ports": [
