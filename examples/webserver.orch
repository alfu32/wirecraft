        "252792fd-dd23-4ac7-96f4-b77ffb328e71"
      ],
      "layout": {
        "x": 578.1788666519222,
        "y": 1092.6908870561558,
        "width": 200.0,
        "height": 70.0,
        "closedWidth": 200.0,
        "closedHeight": 70.0,
        "openWidth": 200.0,
        "openHeight": 70.0,
        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "static const char *const known[] = { \"/home/about\", \"/home/version\", \"/api/user\" };\nReqRep item;\n\nwhile (threadwork_buffer_count(routeNotFoundRequest) > 0U) {\n    char method[8] = \"\";\n    char path[256] = \"\";\n    const char *reason = \"Bad Request\";\n    int length;\n    size_t index;\n\n    if (pop(routeNotFoundRequest, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n    item.response.status = 400;\n    if (sscanf(item.request.header, \"%7s %255s\", method, path) == 2) {\n        char *query = strchr(path, '?');\n\n        if (query != NULL) {\n            *query = '\\0';\n        }\n        path[200] = '\\0';\n        item.response.status = 404;\n        reason = \"Not Found\";\n        for (index = 0U; index < sizeof(known) / sizeof(known[0]); index++) {\n            if (strcmp(path, known[index]) == 0) {\n                item.response.status = 405;\n                reason = \"Method Not Allowed\";\n            }\n        }\n    }\n    item.response.content_type = \"text/plain; charset=utf-8\";\n    length = item.response.status == 400\n        ? snprintf(NULL, 0, \"400 %s\\n\", reason)\n        : snprintf(NULL, 0, \"%d %s: %s\\n\", item.response.status, reason, path);\n    item.response.body = length < 0 ? NULL : (char *)malloc((size_t)length + 1U);\n    if (item.response.body == NULL) {\n        return THREADWORK_ERROR;\n    }\n    if (item.response.status == 400) {\n        (void)snprintf(item.response.body, (size_t)length + 1U, \"400 %s\\n\", reason);\n    } else {\n        (void)snprintf(item.response.body, (size_t)length + 1U, \"%d %s: %s\\n\", item.response.status, reason, path);\n    }\n    if (push(routeNotFoundResponse, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Fallback for everything the router does not match.\n- Unparsable request line: 400 \"400 Bad Request\".\n- Known path with a method other than GET/HEAD: 405 \"405 Method Not Allowed: <path>\"\n  (socket_respond adds \"Allow: GET, HEAD\").\n- Otherwise: 404 \"404 Not Found: <path>\".\nBodies are text/plain; charset=utf-8, heap-allocated, newline-terminated; the path is quoted\nwithout its query string and truncated to 200 bytes.",
        "specificationLanguageId": "markdown",
        "tests": "- \"GET /missing?q=1\" → 404 body \"404 Not Found: /missing\".\n- \"DELETE /api/user\" → 405.\n- \"garbage\" → 400.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
