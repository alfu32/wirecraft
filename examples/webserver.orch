          "id": "input_in",
          "name": "in",
          "direction": "Input",
          "dataType": "",
          "metadata": {}
        },
        {
          "id": "output_out",
          "name": "out",
          "direction": "Output",
          "dataType": "",
          "metadata": {}
        }
      ],
      "link": null,
      "typeDefinition": null,
