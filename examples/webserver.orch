      },
      "text": {
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown",
        "initialization": "",
        "initializationLanguageId": "",
        "source": "static const char text[] = \"Wirecraft WebServer example: a C17 dataflow HTTP server generated from a Wirecraft model.\\n\";\nReqRep item;\n\nwhile (threadwork_buffer_count(routeHomeAboutRequest) > 0U) {\n    if (pop(routeHomeAboutRequest, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n    item.response.status = 200;\n    item.response.content_type = \"text/plain; charset=utf-8\";\n    item.response.body = (char *)malloc(sizeof(text));\n    if (item.response.body == NULL) {\n        return THREADWORK_ERROR;\n    }\n    memcpy(item.response.body, text, sizeof(text));\n    if (push(routeHomeAboutResponse, &item) != THREADWORK_OK) {\n        return THREADWORK_ERROR;\n    }\n}",
        "sourceLanguageId": "",
        "specification": "GET/HEAD /home/about. Responds 200 text/plain; charset=utf-8 with a heap-allocated one-line\ndescription of the example. Leaves response.header to socket_respond.",
        "specificationLanguageId": "markdown",
        "tests": "- Body: \"Wirecraft WebServer example: a C17 dataflow HTTP server generated from a Wirecraft model.\"",
        "testsLanguageId": "json"
      },
      "typeDefinition": null
    },
