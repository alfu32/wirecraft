      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "// Platform classes for the server libraries: TCP sockets, timeouts and I/O errors.\ntypealias ServerSocket = java.net.ServerSocket\ntypealias Socket = java.net.Socket\ntypealias InetSocketAddress = java.net.InetSocketAddress\ntypealias SocketTimeoutException = java.net.SocketTimeoutException\ntypealias IOException = java.io.IOException",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Platform library: the POSIX socket, polling and errno headers shared by the server code,\nlent to socket_accept as `platform` and to lib_http_server. It declares no functions.",
        "specificationLanguageId": "markdown",
        "tests": "",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
