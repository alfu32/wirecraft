    {
      "id": "node_0a2c7213-3906-4fc0-bed6-adaf8a829401",
      "name": "ReqRep",
      "kind": "Type",
      "parentId": "root",
      "children": [],
      "incomingLinks": [],
      "outgoingLinks": [],
      "layout": {
