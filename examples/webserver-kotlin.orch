      "fileLayoutStrategyId": "none",
      "text": {
        "source": "val text = \"Wirecraft WebServer example: a Kotlin dataflow HTTP server generated from a Wirecraft model.\\n\"\n\nwhile (routeHomeAboutRequest.isNotEmpty()) {\n    val item = routeHomeAboutRequest.removeFirst()\n    val answer = item.response.copy(status = 200.0, content_type = \"text/plain; charset=utf-8\", body = text)\n    routeHomeAboutResponse.addLast(item.copy(response = answer))\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "GET/HEAD /home/about. Responds 200 text/plain; charset=utf-8 with a heap-allocated one-line\ndescription of the example. Leaves response.header to socket_respond.",
        "specificationLanguageId": "markdown",
        "tests": "- Body: \"Wirecraft WebServer example: a C17 dataflow HTTP server generated from a Wirecraft model.\"",
        "testsLanguageId": "json",
        "aiInstructions": "",
