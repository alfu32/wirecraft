    {
      "id": "a1832228-ea25-4e9b-9ece-07f7dd635b19",
      "name": "routeNotFound",
      "kind": "Processor",
      "parentId": "node_f0b2f552-0e45-4843-b328-9666bb3357db",
      "children": [],
      "incomingLinks": [
        "cfd0b99d-078f-42a7-8a14-c4a6fe1ad098"
      ],
      "outgoingLinks": [
        "252792fd-dd23-4ac7-96f4-b77ffb328e71"
      ],
      "layout": {
        "x": 588.595023104322,
        "y": 942.95587369488,
        "width": 200.0,
        "height": 70.0,
        "closedWidth": 200.0,
        "closedHeight": 70.0,
        "openWidth": 200.0,
        "openHeight": 70.0,
        "isExpanded": true
      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "known := []string{\"/home/about\", \"/home/version\", \"/api/user\"}\nvar item ReqRep\n\nfor len(*routeNotFoundRequest) > 0 {\n\treason := \"Bad Request\"\n\tpath := \"\"\n\tif !pop(routeNotFoundRequest, &item) {\n\t\treturn errors.New(\"routeNotFound: request buffer holds a value that is not a ReqRep\")\n\t}\n\titem.response.status = 400\n\tif fields := strings.Fields(item.request.header); len(fields) >= 2 {\n\t\tpath = fields[1][:min(len(fields[1]), 255)]\n\t\tif query := strings.IndexByte(path, '?'); query >= 0 {\n\t\t\tpath = path[:query]\n\t\t}\n\t\tpath = path[:min(len(path), 200)]\n\t\titem.response.status = 404\n\t\treason = \"Not Found\"\n\t\tfor _, route := range known {\n\t\t\tif path == route {\n\t\t\t\titem.response.status = 405\n\t\t\t\treason = \"Method Not Allowed\"\n\t\t\t}\n\t\t}\n\t}\n\titem.response.content_type = \"text/plain; charset=utf-8\"\n\tif item.response.status == 400 {\n\t\titem.response.body = fmt.Sprintf(\"400 %s\\n\", reason)\n\t} else {\n\t\titem.response.body = fmt.Sprintf(\"%d %s: %s\\n\", int(item.response.status), reason, path)\n\t}\n\tpush(routeNotFoundResponse, item)\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "Fallback for everything the router does not match.\n- Unparsable request line: 400 \"400 Bad Request\".\n- Known path with a method other than GET/HEAD: 405 \"405 Method Not Allowed: <path>\"\n  (socket_respond adds \"Allow: GET, HEAD\").\n- Otherwise: 404 \"404 Not Found: <path>\".\nBodies are text/plain; charset=utf-8, heap-allocated, newline-terminated; the path is quoted\nwithout its query string and truncated to 200 bytes.",
        "specificationLanguageId": "markdown",
        "tests": "- \"GET /missing?q=1\" → 404 body \"404 Not Found: /missing\".\n- \"DELETE /api/user\" → 405.\n- \"garbage\" → 400.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
      "technology": {
        "languageId": "",
        "technologyId": "",
        "compilerId": "",
        "fileExtension": "",
        "contentType": ""
      },
