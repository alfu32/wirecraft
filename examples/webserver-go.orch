      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "const text = \"Wirecraft WebServer example: a Go dataflow HTTP server generated from a Wirecraft model.\\n\"\nvar item ReqRep\n\nfor len(*routeHomeAboutRequest) > 0 {\n\tif !pop(routeHomeAboutRequest, &item) {\n\t\treturn errors.New(\"routeHomeAbout: request buffer holds a value that is not a ReqRep\")\n\t}\n\titem.response.status = 200\n\titem.response.content_type = \"text/plain; charset=utf-8\"\n\titem.response.body = text\n\tpush(routeHomeAboutResponse, item)\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "GET/HEAD /home/about. Responds 200 text/plain; charset=utf-8 with a heap-allocated one-line\ndescription of the example. Leaves response.header to socket_respond.",
        "specificationLanguageId": "markdown",
        "tests": "- Body: \"Wirecraft WebServer example: a C17 dataflow HTTP server generated from a Wirecraft model.\"",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
