      "text": {
        "source": "const text = \"WebServer 0.1.0 (Wirecraft Go)\\n\"\nvar item ReqRep\n\nfor len(*routeHomeVersionRequest) > 0 {\n\tif !pop(routeHomeVersionRequest, &item) {\n\t\treturn errors.New(\"routeHomeVersion: request buffer holds a value that is not a ReqRep\")\n\t}\n\titem.response.status = 200\n\titem.response.content_type = \"text/plain; charset=utf-8\"\n\titem.response.body = text\n\tpush(routeHomeVersionResponse, item)\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "GET/HEAD /home/version. Responds 200 text/plain; charset=utf-8 with a heap-allocated body\n\"WebServer 0.1.0 (Wirecraft C17)\" and a trailing newline.",
        "specificationLanguageId": "markdown",
        "tests": "- Body equals \"WebServer 0.1.0 (Wirecraft C17)\\n\".",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
