      },
      "fileLayoutStrategyId": "none",
      "text": {
        "source": "const text = `{\"id\":1,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.invalid\",\"roles\":[\"admin\",\"author\"]}` + \"\\n\"\nvar item ReqRep\n\nfor len(*routeApiUserDetailsRequest) > 0 {\n\tif !pop(routeApiUserDetailsRequest, &item) {\n\t\treturn errors.New(\"routeApiUserDetails: request buffer holds a value that is not a ReqRep\")\n\t}\n\titem.response.status = 200\n\titem.response.content_type = \"application/json\"\n\titem.response.body = text\n\tpush(routeApiUserDetailsResponse, item)\n}",
        "sourceLanguageId": "",
        "initialization": "",
        "initializationLanguageId": "",
        "specification": "GET/HEAD /api/user. Responds 200 application/json with a placeholder user document:\n{\"id\":1,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.invalid\",\"roles\":[\"admin\",\"author\"]}\nfollowed by a newline. The data is static; no persistence is involved.",
        "specificationLanguageId": "markdown",
        "tests": "- Body parses as JSON and has name \"Ada Lovelace\" and two roles.",
        "testsLanguageId": "json",
        "aiInstructions": "",
        "aiInstructionsLanguageId": "markdown"
      },
      "binaryContent": null,
