      "text": {
        "source": "// Platform packages for the server libraries: TCP sockets, deadlines and text parsing.\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"net\"\n\t\"strconv\"\n\t\"time\"\n)",
