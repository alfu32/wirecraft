{
  "id": "wirecraft-example-quickjs",
  "name": "hello-quickjs",
  "rootNodeId": "root",
  "nodes": [
    {
      "id": "root",
      "name": "hello_quickjs",
      "kind": "Node",
      "children": [
        "worker"
      ],
      "technology": {
        "languageId": "javascript",
        "technologyId": "quickjs"
      },
      "fileLayoutStrategyId": "single-file"
    },
    {
      "id": "worker",
      "name": "print_once",
      "kind": "Processor",
      "parentId": "root",
      "text": {
        "source": "if (threadworkRunner.isRunning()) { console.log(\"Hello from Wirecraft QuickJS\"); threadworkRunner.shutdownRequest(); }"
      }
    }
  ]
}
